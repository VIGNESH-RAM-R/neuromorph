# Copy this file to .env (same folder), then fill in your real values.
# .env is gitignored -- your keys never get committed by accident.
# Full step-by-step instructions for getting both: SETUP_OAUTH.md

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
VITE_GOOGLE_CLIENT_ID=

# Facebook for Developers -> My Apps -> your app -> Settings -> Basic -> App ID
VITE_FACEBOOK_APP_ID=

# Firebase Console -> Project settings -> General -> "Your apps" -> Web app -> SDK setup and configuration
# Full walkthrough: FIREBASE_SETUP.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional -- App Check hardens askMorphy against being called by anything
# that isn't this real app. Leave blank and the app works exactly as
# before (App Check simply stays off). Full walkthrough: APPCHECK_SETUP.md
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optional -- powers the live worldwide city/state/country search on the
# doctor onboarding form's "Medical license region" field. Leave blank and
# that field falls back to a plain text input, everything else works as
# before. Full walkthrough: GOOGLE_PLACES_SETUP.md
VITE_GOOGLE_MAPS_API_KEY=
